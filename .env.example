# Environment placeholders (Firebase AI Logic uses App Check attestation and requires no API key)
# RESEND_API_KEY: Required to dispatch Super Admin password reset OTP emails to rsingh13151@gmail.com.
# Configure this value in the Secrets panel in AI Studio.
RESEND_API_KEY=MY_RESEND_API_KEY
# OTP_WEBHOOK_URL: Optional custom HTTPS endpoint (e.g. on https://www.mvci.online) for sending OTP emails.
OTP_WEBHOOK_URL=UNCONFIGURED
